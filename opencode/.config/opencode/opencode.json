{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:3845/sse"
    },
    "linear": {
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode-go/kimi-k2.6",
  "permission": {
    "bash": {
      "*": "deny",
      "bd *": "allow",
      "bun add*": "ask",
      "bun install": "allow",
      "bun run build*": "allow",
      "bun run check*": "allow",
      "bun run lint*": "allow",
      "bun run test*": "allow",
      "bun run typecheck*": "allow",
      "bun run*": "ask",
      "bun test*": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "cp *": "ask",
      "git --version": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git remote -v": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "node *": "ask",
      "node --version": "allow",
      "npm --version": "allow",
      "npm install": "allow",
      "npm install*": "ask",
      "npm run 2>&1": "allow",
      "npm run build*": "allow",
      "npm run check*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run typecheck*": "allow",
      "npm run*": "ask",
      "npx *": "ask",
      "npx eslint *": "allow",
      "npx tsc *": "allow",
      "npx vitest *": "allow",
      "pnpm --version": "allow",
      "pnpm install": "allow",
      "pnpm install*": "ask",
      "pnpm run build*": "allow",
      "pnpm run check*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run test*": "allow",
      "pnpm run*": "ask",
      "pwd": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "tail *": "allow",
      "touch *": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "tools": {
    "figma": false,
    "linear": false,
    "notion": false
  }
}